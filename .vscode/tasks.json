{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-2019",
      "type": "shell",
      "windows": {
        "command": "${input:msbuild2019}",
        "args": [
          "/restore",
          "/v:Minimal",
          "/p:Configuration=${input:configuration}",
          "/p:VSVersion=2019",
          "${workspaceFolder}/Rhino.VisualStudio.Windows/Rhino.VisualStudio.Windows.csproj",
        ],
      },
      "args": [],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "clear": true
      },
      "group": "build"
    },
    {
      "label": "build-2022",
      "type": "shell",
      "windows": {
        "command": "${input:msbuild2022}",
        "args": [
          "/restore",
          "/v:Minimal",
          "/p:Configuration=${input:configuration}",
          "/p:VSVersion=2022",
          "${workspaceFolder}/Rhino.VisualStudio.Windows/Rhino.VisualStudio.Windows.csproj",
        ],
      },
      "args": [],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "clear": true
      },
      "group": "build"
    },
    {
      // VS 2026 uses the 2022 extension; building with its MSBuild deploys to its Exp instance.
      "label": "build-2026",
      "type": "shell",
      "windows": {
        "command": "${input:msbuild2026}",
        "args": [
          "/restore",
          "/v:Minimal",
          "/p:Configuration=${input:configuration}",
          "/p:VSVersion=2022",
          "${workspaceFolder}/Rhino.VisualStudio.Windows/Rhino.VisualStudio.Windows.csproj",
        ],
      },
      "args": [],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "clear": true
      },
      "group": "build"
    },
    {
      "label": "build-templates",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "/p:Configuration=${input:configuration}",
        "/p:GenerateFullPaths=true",
        "-clp:NoSummary",
        "${workspaceFolder}/Rhino.Templates/Rhino.Templates.csproj"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "clear": true
      }
    },
    {
      // Installs the newest built package, whichever configuration it came from.
      "label": "install-templates",
      "type": "shell",
      "dependsOn": "build-templates",
      "osx": {
        "command": "dotnet new uninstall Rhino.Templates; dotnet new install \"$(ls -t ${workspaceFolder}/artifacts/bin/Rhino.Templates/*/Rhino.Templates.*.nupkg | head -1)\" --force"
      },
      "linux": {
        "command": "dotnet new uninstall Rhino.Templates; dotnet new install \"$(ls -t ${workspaceFolder}/artifacts/bin/Rhino.Templates/*/Rhino.Templates.*.nupkg | head -1)\" --force"
      },
      "windows": {
        "command": "dotnet new uninstall Rhino.Templates; dotnet new install (Get-ChildItem '${workspaceFolder}/artifacts/bin/Rhino.Templates/*/Rhino.Templates.*.nupkg' | Sort-Object LastWriteTime -Descending | Select-Object -First 1).FullName --force"
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "generate-templates",
      "type": "shell",
      "dependsOn": "build-templates",
      "command": "dotnet build ${workspaceFolder}/build/GenerateTemplates.proj",
      "problemMatcher": "$msCompile",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "build-all",
      "dependsOn": [
        "build-templates",
        "build-2019",
        "build-2022"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "build-xcode-templates",
      "type": "shell",
      "command": "${workspaceFolder}/Rhino.Xcode/build-pkg.sh",
      "problemMatcher": [],
      "presentation": {
        "clear": true
      }
    },
    {
      // Installs through the pkg so its install script is tested too. Restart Xcode afterwards.
      "label": "install-xcode-templates",
      "type": "shell",
      "dependsOn": "build-xcode-templates",
      "command": "sudo installer -pkg \"$(ls -t ${workspaceFolder}/artifacts/xcode/RhinoXcodeTemplates-*.pkg | head -1)\" -target /",
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "install-macos-workload",
      "type": "shell",
      "command": "sudo dotnet workload install macos --from-rollback-file dotnet-workloads.json",
      "problemMatcher": "$msCompile",
      "presentation": {
        "clear": true,
        "focus": true
      }
    }
  ],
  "inputs": [
    {
      "id": "msbuild2019",
      "type": "command",
      "command": "shellCommand.execute",
      "args": {
        "command": "\"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -version \"[16,17)\" -latest -products * -requires Microsoft.Component.MSBuild -find MSBuild\\**\\Bin\\MSBuild.exe",
        "useFirstResult": "true"
      }
    },
    {
      "id": "msbuild2022",
      "type": "command",
      "command": "shellCommand.execute",
      "args": {
        "command": "\"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -version \"[17,18)\" -latest -products * -requires Microsoft.Component.MSBuild -find MSBuild\\**\\Bin\\MSBuild.exe",
        "useFirstResult": "true"
      }
    },
    {
      "id": "msbuild2026",
      "type": "command",
      "command": "shellCommand.execute",
      "args": {
        "command": "\"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -version \"[18,19)\" -latest -products * -requires Microsoft.Component.MSBuild -find MSBuild\\**\\Bin\\MSBuild.exe",
        "useFirstResult": "true"
      }
    },
    {
      "type": "pickString",
      "id": "configuration",
      "description": "Build Configuration (press escape to continue without building)",
      "options": [
        "Debug",
        "Release"
      ],
      "default": "Debug"
    }
  ]
}