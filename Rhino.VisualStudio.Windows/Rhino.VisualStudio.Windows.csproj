<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Rhino.VisualStudio.Windows</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <DefineConstants>$(DefineConstants);VS$(VSVersion)</DefineConstants>
    <OutputPath>$(BaseOutputPath)$(VSVersion)\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <VsixDeployOnDebug>true</VsixDeployOnDebug>
    <!-- Deploy on build so the VS Code launch configs get a fresh Exp install. -->
    <DeployExtension Condition="'$(DeployExtension)' == ''">true</DeployExtension>
    <UseCodebase>true</UseCodebase>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <TemplateSourceRoot>$(MSBuildProjectDirectory)\Templates\</TemplateSourceRoot>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <TargetVsixContainerName>Rhino.VisualStudio.Windows.$(VSVersion)-$(PackageVersion).vsix</TargetVsixContainerName>
    <TargetVsixContainer>$(ArtifactsDir)$(Configuration)\$(TargetVsixContainerName)</TargetVsixContainer>

    <SignAssembly>false</SignAssembly>
    <AssemblyOriginatorKeyFile>..\build\rhinocommonsignature.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <PropertyGroup Condition="$(VSVersion) == '2022'">
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="icon.ico;license.rtf;rhino.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="template.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="$(ArtifactsDir)bin\Rhino.Templates\$(Configuration)\vsix\Rhino.Templates.VisualStudio.$(Version).nupkg">
      <Link>Rhino.Templates.VisualStudio.$(Version).nupkg</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Resource Include="Templates\**\icon.ico" />
    <None Remove="20*\source.extension.vsixmanifest" />
    <None Include="$(VSVersion)\source.extension.vsixmanifest" />
    <None Include="..\build\rhinocommonsignature.snk" Link="rhinocommonsignature.snk" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ReachFramework" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="PresentationFramework.Aero2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Eto.Platform.Wpf" Version="2.7.5" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="$(VSVersion) == '2019'">
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="16.10.31321.278" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.TemplateWizardInterface" Version="16.10.31320.204" />
  </ItemGroup>
  <ItemGroup Condition="$(VSVersion) == '2022'">
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.5.33428.388" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.TemplateWizardInterface" Version="17.0.31902.203" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack, not Build: the templates project sets NoBuild, which the .NET SDK rejects when Build is invoked. -->
    <!-- Kept apart from the nuget.org package so an older 'dotnet new install' of it can't override the bundled templates. -->
    <ProjectReference Include="..\Rhino.Templates\Rhino.Templates.csproj" Targets="Pack" Private="false" ReferenceOutputAssembly="false"
                      AdditionalProperties="ForVisualStudio=true;PackageOutputPath=$(ArtifactsDir)bin\Rhino.Templates\$(Configuration)\vsix\" />
    <ProjectReference Include="..\Rhino.VisualStudio\Rhino.VisualStudio.csproj" />
  </ItemGroup>

  <Import Project="Properties\wafflebuilder.targets" />

  <Target Name="ClearTemplateCache" AfterTargets="AfterBuild">
    <RemoveDir Directories="$(LOCALAPPDATA)\Microsoft\VisualStudio\16.0_aa19621cExp\TemplateEngineHost" Condition="$(VSVersion) == '2019'" />
    <RemoveDir Directories="$(LOCALAPPDATA)\Microsoft\VisualStudio\17.0_cf5e1df9Exp\TemplateEngineHost" Condition="$(VSVersion) == '2022'" />
  </Target>
  <!-- The build tools' suppression list assumes current VS, which ships these; VS 2019 may not. -->
  <Target Name="KeepVS2019Dependencies" BeforeTargets="GetVsixSourceItems" Condition="$(VSVersion) == '2019'">
    <ItemGroup>
      <SuppressFromVsix Remove="Microsoft.Win32.Registry.dll;System.Security.AccessControl.dll;System.Security.Principal.Windows.dll" />
    </ItemGroup>
  </Target>
  <Target Name="CreateDirectory for vsix" BeforeTargets="CreateVsixContainer">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName($(TargetVsixContainer)))" />
  </Target>
</Project>
