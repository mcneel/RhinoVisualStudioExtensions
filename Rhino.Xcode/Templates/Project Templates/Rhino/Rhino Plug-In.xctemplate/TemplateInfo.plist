					<string>/bin/sh</string>
					<key>ShellScript</key>
					<string># Rhino is not debuggable by default; this re-signs it once so Xcode can attach.
# Turn off with the RHINO_MAKE_DEBUGGABLE build setting.
[ "$RHINO_MAKE_DEBUGGABLE" = YES ] || exit 0
touch "$SCRIPT_OUTPUT_FILE_0"
debuggable() { codesign -d --entitlements - "$RHINO_APP" 2&gt;/dev/null | grep -q get-task-allow; }
debuggable &amp;&amp; exit 0
"$SRCROOT/SDK/script/make_rhino_debuggable.sh" "$RHINO_APP"
debuggable || echo "warning: Could not make $RHINO_APP debuggable"
</string>
					<!-- Reruns only when Rhino's signature changes, e.g. after a Rhino update. -->
					<key>InputFiles</key>
					<array>
						<string>$(RHINO_APP)/Contents/_CodeSignature/CodeResources</string>
					</array>
					<key>OutputFiles</key>
					<array>
						<string>$(DERIVED_FILE_DIR)/rhino-debuggable.stamp</string>
					</array>
				</dict>
			</array>
