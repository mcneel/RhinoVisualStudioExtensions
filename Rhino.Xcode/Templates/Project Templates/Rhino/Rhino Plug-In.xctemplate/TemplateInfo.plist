					<string>$(SRCROOT)/SDK/lib/OpenNURBS.tbd</string>
					<string>$(SRCROOT)/SDK/lib/RhMaterialEditor.tbd</string>
				</array>
				<!-- The SDK headers are Objective-C++ on macOS. -->
				<key>GCC_INPUT_FILETYPE</key>
				<string>sourcecode.cpp.objcpp</string>
				<!-- The SDK headers have many doc comments that clang can't match to declarations. -->
				<key>CLANG_WARN_DOCUMENTATION_COMMENTS</key>
				<string>NO</string>
				<key>CLANG_ENABLE_OBJC_ARC</key>
				<string>YES</string>
				<key>CLANG_CXX_LANGUAGE_STANDARD</key>
				<string>c++14</string>
				<key>USE_HEADERMAP</key>
				<string>NO</string>
				<key>GCC_SYMBOLS_PRIVATE_EXTERN</key>
				<string>NO</string>
				<key>GCC_INLINES_ARE_PRIVATE_EXTERN</key>
				<string>YES</string>
				<key>OTHER_CFLAGS</key>
				<string>$(inherited) -fno-operator-names -Wno-nonportable-include-path -Wno-deprecated-register -Wno-deprecated-declarations -Wno-documentation-deprecated-sync -Wno-ignored-attributes -Wno-undefined-bool-conversion -Wno-dynamic-class-memaccess -Wno-defaulted-function-deleted -Wno-#pragma-messages -DGL_DO_NOT_WARN_IF_MULTI_GL_VERSION_HEADERS_INCLUDED</string>
				<!-- The debuggable script re-signs Rhino outside the project folder. -->
